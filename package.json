{
  "name": "@dani/loading",
  "version": "1.0.0",
  "description": "Curated loading-state design library for discovering, understanding, customizing, and shipping better loading experiences.",
  "type": "module",
  "author": "Dani Asyrofi",
  "license": "MIT",
  "bin": {
    "loading": "./bin/cli.mjs",
    "@dani/loading": "./bin/cli.mjs"
  },
  "scripts": {
    "dev": "serve . -l tcp://127.0.0.1:3000",
    "start": "serve . -l tcp://127.0.0.1:3000",
    "build": "node scripts/build-site.mjs",
    "preview:cloudflare": "npm run build && wrangler pages dev",
    "deploy:cloudflare": "npm run build && wrangler pages deploy",
    "test": "node --test specimens/tests/*.test.mjs tests/*.test.mjs",
    "validate": "node scripts/validate-specimens.mjs",
    "benchmark": "node scripts/benchmark-loaders.mjs"
  },
  "keywords": [
    "loading",
    "motion-design",
    "loaders",
    "ai-thinking",
    "shadcn",
    "webgl",
    "canvas2d",
    "svg-animation"
  ],
  "devDependencies": {
    "serve": "^14.2.6",
    "wrangler": "^4.129.0"
  }
}
